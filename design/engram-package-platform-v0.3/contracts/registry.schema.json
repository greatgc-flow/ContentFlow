{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.invalid/epp/v03/registry.schema.json",
  "title": "registry TEST_ONLY proposed contract; not production authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixture_only": {
      "const": true
    },
    "schema_version": {
      "const": "1.0"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "state": {
            "enum": [
              "INSTALLED",
              "PARTIAL",
              "DATA_RETAINED"
            ]
          },
          "slot_rel": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
            "maxLength": 240
          },
          "profile": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "active_generation": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "previous_generation": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "release_manifest_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "runtime_binding_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "ownership_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "package_id",
          "state",
          "slot_rel",
          "profile",
          "active_generation",
          "previous_generation",
          "release_manifest_sha256",
          "runtime_binding_ids",
          "ownership_receipt_sha256"
        ]
      },
      "minItems": 0,
      "maxItems": 128
    }
  },
  "required": [
    "fixture_only",
    "schema_version",
    "installation_id",
    "revision",
    "entries"
  ]
}
