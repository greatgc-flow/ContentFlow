{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engram.invalid/epp/v03/checkpoint.schema.json",
  "title": "checkpoint TEST_ONLY proposed contract; not production authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fixture_only": {
      "const": true
    },
    "schema_version": {
      "const": "1.0"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,47}$"
    },
    "generation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "domain_schema": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "release_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pending_intent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 1024,
      "uniqueItems": true
    },
    "omitted_classes": {
      "type": "array",
      "items": {
        "enum": [
          "PROGRAM",
          "RUNTIME_REF",
          "DOMAIN_DATA",
          "USER_CONFIG",
          "SECRET_REF",
          "MODEL_DATA",
          "CACHE",
          "LOG",
          "BACKUP",
          "EXTERNAL_REF"
        ]
      },
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true
    },
    "credential_transfer": {
      "const": false
    },
    "external_authority_transfer": {
      "const": false
    },
    "source_deactivation": {
      "enum": [
        "NOT_APPLICABLE",
        "PROVEN_LOCAL",
        "OWNER_ATTESTED",
        "UNKNOWN"
      ]
    },
    "restore_verified": {
      "type": "boolean"
    }
  },
  "required": [
    "fixture_only",
    "schema_version",
    "checkpoint_id",
    "installation_id",
    "package_id",
    "generation",
    "domain_schema",
    "created_at",
    "release_manifest_sha256",
    "runtime_lock_sha256",
    "inventory_sha256",
    "pending_intent_ids",
    "omitted_classes",
    "credential_transfer",
    "external_authority_transfer",
    "source_deactivation",
    "restore_verified"
  ]
}
